# ── Ringfence configuration ───────────────────────────────────────────────
# Copy to .env. Every value here is optional — the system runs fully without
# any of them, because nothing on the detection path depends on an external
# service.

# ── LLM dossier summary (OPTIONAL) ────────────────────────────────────────
# Generates the narrative summary FROM the deterministic evidence. Without a
# key the dossier is still complete and still ships, with a deterministic
# template summary and llm_status=skipped:no_api_key. The evidence is the
# product; the narrative is a convenience.
OPENAI_API_KEY=
RINGFENCE_LLM_MODEL=gpt-4o-mini
RINGFENCE_LLM_TIMEOUT=8

# ── Service ───────────────────────────────────────────────────────────────
RINGFENCE_API_HOST=0.0.0.0
RINGFENCE_API_PORT=8000
# Where the Streamlit dashboard looks for the API. Inside docker-compose this
# is set to http://api:8000 by the compose file.
RINGFENCE_API_URL=http://localhost:8000

# ── Observability ─────────────────────────────────────────────────────────
# 1 = one JSON object per log line (what the container sets)
RINGFENCE_JSON_LOGS=0
RINGFENCE_LOG_LEVEL=INFO

# ── Storage ───────────────────────────────────────────────────────────────
# Override to relocate every artifact path. The test suite sets this to a
# temp directory so a test run can never clobber demo data.
# RINGFENCE_DATA_DIR=/app/data

# ── Optional vector backend ───────────────────────────────────────────────
# Case memory uses a pure-numpy cosine index by default so `make test` runs
# without a ~2GB torch download. Set to 1 AND install the extras to switch to
# ChromaDB:  pip install "chromadb>=0.5" "sentence-transformers>=2.7"
RINGFENCE_USE_CHROMA=0
